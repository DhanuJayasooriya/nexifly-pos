PORT=4000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexifly_pos
DB_USER=postgres
DB_PASSWORD=your_database_password

# JWT: use a long random string, e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Barcode: first 6 digits of your EAN-13 barcodes (your GS1 company prefix)
BARCODE_COMPANY_PREFIX=629999

FRONTEND_URL=http://localhost:3000
